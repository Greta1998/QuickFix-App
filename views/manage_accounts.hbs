<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Manage Accounts - QuickFix</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.7.2/font/bootstrap-icons.css" rel="stylesheet">
    <style>
        .account-card {
            transition: transform 0.2s;
        }
        .account-card:hover {
            transform: translateY(-2px);
        }
        .role-badge {
            font-size: 0.8rem;
        }
        .delete-btn {
            transition: all 0.2s;
        }
        .delete-btn:hover {
            transform: scale(1.05);
        }
    </style>
</head>
<body>
    <div class="container-fluid">
        <div class="row">
            <!-- Main Content -->
            <div class="col-12 px-md-4">
                <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
                    <h1 class="h2">Manage Accounts</h1>
                    <div class="btn-toolbar mb-2 mb-md-0">
                        <div class="btn-group me-2">
                            <button type="button" class="btn btn-sm btn-outline-secondary" onclick="refreshAccounts()">
                                <i class="bi bi-arrow-clockwise"></i> Refresh
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Statistics Cards -->
                <div class="row mb-4">
                    <div class="col-md-4">
                        <div class="card text-white bg-primary">
                            <div class="card-body">
                                <div class="d-flex justify-content-between">
                                    <div>
                                        <h4 class="card-title">{{totalUsers}}</h4>
                                        <p class="card-text">Total Users</p>
                                    </div>
                                    <div class="align-self-center">
                                        <i class="bi bi-people fs-1"></i>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="card text-white bg-success">
                            <div class="card-body">
                                <div class="d-flex justify-content-between">
                                    <div>
                                        <h4 class="card-title">{{homeowners}}</h4>
                                        <p class="card-text">Homeowners</p>
                                    </div>
                                    <div class="align-self-center">
                                        <i class="bi bi-house fs-1"></i>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="card text-white bg-info">
                            <div class="card-body">
                                <div class="d-flex justify-content-between">
                                    <div>
                                        <h4 class="card-title">{{technicians}}</h4>
                                        <p class="card-text">Technicians</p>
                                    </div>
                                    <div class="align-self-center">
                                        <i class="bi bi-tools fs-1"></i>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Search and Filter -->
                <div class="row mb-4">
                    <div class="col-md-8">
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-search"></i></span>
                            <input type="text" class="form-control" id="searchInput" placeholder="Search by name or email...">
                        </div>
                    </div>
                    <div class="col-md-4">
                        <select class="form-select" id="roleFilter">
                            <option value="">All Roles</option>
                            <option value="homeowner">Homeowners</option>
                            <option value="technician">Technicians</option>
                        </select>
                    </div>
                </div>

                <!-- Accounts List -->
                <div class="row" id="accountsList">
                    {{#each users}}
                    <div class="col-md-6 col-lg-4 mb-3 account-item" data-role="{{this.role}}" data-name="{{this.name}}" data-email="{{this.email}}">
                        <div class="card account-card h-100">
                            <div class="card-body">
                                <div class="d-flex justify-content-between align-items-start mb-2">
                                    <h5 class="card-title">{{this.name}}</h5>
                                    <span class="badge bg-{{#if (eq this.role 'admin')}}warning{{else if (eq this.role 'technician')}}info{{else}}success{{/if}} role-badge">
                                        {{#if (eq this.role 'admin')}}Admin{{else if (eq this.role 'technician')}}Technician{{else}}Homeowner{{/if}}
                                    </span>
                                </div>
                                <p class="card-text">
                                    <i class="bi bi-envelope"></i> {{this.email}}
                                </p>
                                {{#if this.phone}}
                                <p class="card-text">
                                    <i class="bi bi-phone"></i> {{this.phone}}
                                </p>
                                {{/if}}
                                {{#if this.location}}
                                <p class="card-text">
                                    <i class="bi bi-geo-alt"></i> {{this.location}}
                                </p>
                                {{/if}}
                                {{#if this.specialty}}
                                <p class="card-text">
                                    <i class="bi bi-tools"></i> {{this.specialty}}
                                </p>
                                {{/if}}
                            </div>
                            <div class="card-footer bg-transparent">
                                <div class="d-flex justify-content-between">
                                    <small class="text-muted">
                                        Joined: {{#if this.timestamp}}{{formatDate this.timestamp}}{{else}}Unknown{{/if}}
                                    </small>
                                    <button class="btn btn-sm btn-outline-danger delete-btn" onclick="confirmDeleteAccount('{{this.email}}', '{{this.name}}')">
                                        <i class="bi bi-trash"></i> Delete
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                    {{/each}}
                </div>

                <!-- No Accounts Message -->
                <div id="noAccountsMessage" class="text-center py-5" style="display: none;">
                    <i class="bi bi-people fs-1 text-muted"></i>
                    <h4 class="text-muted mt-3">No accounts found</h4>
                    <p class="text-muted">Try adjusting your search or filter criteria.</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Delete Confirmation Modal -->
    <div class="modal fade" id="deleteModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title">
                        <i class="bi bi-exclamation-triangle"></i> Confirm Account Deletion
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <p>Are you sure you want to delete this account?</p>
                    <div class="alert alert-warning">
                        <strong>Account:</strong> <span id="deleteAccountName"></span><br>
                        <strong>Email:</strong> <span id="deleteAccountEmail"></span>
                    </div>
                    <p class="text-danger"><strong>Warning:</strong> This action cannot be undone. All associated data will be permanently deleted.</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-danger" id="confirmDeleteBtn">
                        <i class="bi bi-trash"></i> Delete Account
                    </button>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        let deleteAccountEmail = '';

        function refreshAccounts() {
            location.reload();
        }

        function applyFilters() {
            const searchTerm = document.getElementById('searchInput').value.toLowerCase();
            const roleFilter = document.getElementById('roleFilter').value;
            const accounts = document.querySelectorAll('.account-item');
            let visibleCount = 0;

            accounts.forEach(account => {
                const name = account.dataset.name.toLowerCase();
                const email = account.dataset.email.toLowerCase();
                const role = account.dataset.role;
                
                const matchesSearch = name.includes(searchTerm) || email.includes(searchTerm);
                const matchesRole = !roleFilter || role === roleFilter;
                
                if (matchesSearch && matchesRole) {
                    account.style.display = 'block';
                    visibleCount++;
                } else {
                    account.style.display = 'none';
                }
            });

            const noAccountsMessage = document.getElementById('noAccountsMessage');
            if (visibleCount === 0) {
                noAccountsMessage.style.display = 'block';
            } else {
                noAccountsMessage.style.display = 'none';
            }
        }

        function confirmDeleteAccount(email, name) {
            deleteAccountEmail = email;
            document.getElementById('deleteAccountName').textContent = name;
            document.getElementById('deleteAccountEmail').textContent = email;
            
            const modal = new bootstrap.Modal(document.getElementById('deleteModal'));
            modal.show();
        }

        document.getElementById('confirmDeleteBtn').addEventListener('click', function() {
            if (deleteAccountEmail) {
                deleteAccount(deleteAccountEmail);
            }
        });

        async function deleteAccount(email) {
            try {
                const response = await fetch('/admin/delete-account', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({ email: email })
                });

                const result = await response.json();

                if (result.success) {
                    // Close modal
                    const modal = bootstrap.Modal.getInstance(document.getElementById('deleteModal'));
                    modal.hide();
                    
                    // Show success message
                    alert('Account deleted successfully!');
                    
                    // Refresh the page
                    location.reload();
                } else {
                    alert('Error deleting account: ' + result.message);
                }
            } catch (error) {
                console.error('Delete account error:', error);
                alert('Error deleting account. Please try again.');
            }
        }

        // Search as you type
        document.getElementById('searchInput').addEventListener('input', applyFilters);
        document.getElementById('roleFilter').addEventListener('change', applyFilters);
    </script>
</body>
</html>

