<div class="container-fluid mt-4">
    <!-- Header -->
    <div class="row mb-4">
        <div class="col-12">
            <h2 class="text-center mb-3">Technician Dashboard</h2>
        </div>
    </div>

    <!-- Statistics Cards -->
    <div class="row mb-4">
        <div class="col-md-3 mb-3">
            <div class="card bg-primary text-white">
                <div class="card-body text-center">
                    <h5 class="card-title">Total Requests</h5>
                    <h2 class="mb-0">{{stats.total}}</h2>
                </div>
            </div>
        </div>
        <div class="col-md-3 mb-3">
            <div class="card bg-success text-white">
                <div class="card-body text-center">
                    <h5 class="card-title">Completed</h5>
                    <h2 class="mb-0">{{stats.completed}}</h2>
                </div>
            </div>
        </div>
        <div class="col-md-3 mb-3">
            <div class="card bg-warning text-white">
                <div class="card-body text-center">
                    <h5 class="card-title">Pending</h5>
                    <h2 class="mb-0">{{stats.pending}}</h2>
                </div>
            </div>
        </div>
        <div class="col-md-3 mb-3">
            <div class="card bg-info text-white">
                <div class="card-body text-center">
                    <h5 class="card-title">Completion Rate</h5>
                    <h2 class="mb-0">{{stats.completionRate}}%</h2>
                </div>
            </div>
        </div>
    </div>

    <!-- Charts Row -->
    <div class="row mb-4">
        <!-- Monthly Completion Rate Chart -->
        <div class="col-md-6 mb-4">
            <div class="card">
                <div class="card-header">
                    <h5 class="card-title mb-0">Monthly Completion Rate</h5>
                </div>
                <div class="card-body">
                    <canvas id="monthlyChart" width="400" height="200"></canvas>
                </div>
            </div>
        </div>

        <!-- Weekly Completion Rate Chart -->
        <div class="col-md-6 mb-4">
            <div class="card">
                <div class="card-header">
                    <h5 class="card-title mb-0">Weekly Completion Rate</h5>
                </div>
                <div class="card-body">
                    <canvas id="weeklyChart" width="400" height="200"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- Status Distribution Chart -->
    <div class="row mb-4">
        <div class="col-md-6 mb-4">
            <div class="card">
                <div class="card-header">
                    <h5 class="card-title mb-0">Request Status Distribution</h5>
                </div>
                <div class="card-body">
                    <canvas id="statusChart" width="400" height="200"></canvas>
                </div>
            </div>
        </div>

        <!-- Performance Metrics -->
        <div class="col-md-6 mb-4">
            <div class="card">
                <div class="card-header">
                    <h5 class="card-title mb-0">Performance Metrics</h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-6">
                            <div class="text-center">
                                <h4 class="text-success">{{stats.completed}}</h4>
                                <small class="text-muted">Completed</small>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="text-center">
                                <h4 class="text-warning">{{stats.accepted}}</h4>
                                <small class="text-muted">In Progress</small>
                            </div>
                        </div>
                    </div>
                    <hr>
                    <div class="row">
                        <div class="col-6">
                            <div class="text-center">
                                <h4 class="text-danger">{{stats.rejected}}</h4>
                                <small class="text-muted">Rejected</small>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="text-center">
                                <h4 class="text-primary">{{stats.pending}}</h4>
                                <small class="text-muted">Pending</small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Performance Analytics Row -->
    <div class="row mb-4">
        <div class="col-md-6 mb-4">
            <div class="card">
                <div class="card-header">
                    <h5 class="card-title mb-0">Request Volume Trends</h5>
                </div>
                <div class="card-body">
                    <canvas id="volumeChart" width="400" height="200"></canvas>
                </div>
            </div>
        </div>
        <div class="col-md-6 mb-4">
            <div class="card">
                <div class="card-header">
                    <h5 class="card-title mb-0">Response Time Analytics</h5>
                </div>
                <div class="card-body">
                    <canvas id="responseChart" width="400" height="200"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- Service Quality Metrics -->
    <div class="row mb-4">
        <div class="col-md-6 mb-4">
            <div class="card">
                <div class="card-header">
                    <h5 class="card-title mb-0">Service Quality Score</h5>
                </div>
                <div class="card-body text-center">
                    <div class="display-4 text-success mb-2">{{stats.completionRate}}%</div>
                    <p class="text-muted">Overall Completion Rate</p>
                    <div class="progress mb-3" style="height: 10px;">
                        <div class="progress-bar bg-success" role="progressbar" style="width: {{stats.completionRate}}%" aria-valuenow="{{stats.completionRate}}" aria-valuemin="0" aria-valuemax="100"></div>
                    </div>
                    <small class="text-muted">{{stats.completed}} of {{stats.total}} requests completed</small>
                </div>
            </div>
        </div>
        <div class="col-md-6 mb-4">
            <div class="card">
                <div class="card-header">
                    <h5 class="card-title mb-0">Performance Summary</h5>
                </div>
            <div class="card-body">
                    <div class="row text-center">
                        <div class="col-6 mb-3">
                            <div class="border-end">
                                <h4 class="text-primary mb-1">{{stats.accepted}}</h4>
                                <small class="text-muted">Accepted</small>
                            </div>
                        </div>
                        <div class="col-6 mb-3">
                            <h4 class="text-warning mb-1">{{stats.pending}}</h4>
                            <small class="text-muted">Pending</small>
                        </div>
                        <div class="col-6">
                            <div class="border-end">
                                <h4 class="text-success mb-1">{{stats.completed}}</h4>
                                <small class="text-muted">Completed</small>
                            </div>
                        </div>
                        <div class="col-6">
                            <h4 class="text-danger mb-1">{{stats.rejected}}</h4>
                            <small class="text-muted">Rejected</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Request Management Section -->
    <div class="row mb-4">
        <div class="col-12">
            <h3 class="mb-3">Request Management</h3>
            
            <!-- Request Status Tabs -->
            <ul class="nav nav-tabs" id="requestTabs" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active" id="approved-tab" data-bs-toggle="tab" data-bs-target="#approved" type="button" role="tab">
                        Approved Requests
                        {{#if approvedRequests.length}}
                            <span class="badge bg-primary ms-2">{{approvedRequests.length}}</span>
                        {{/if}}
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="rejected-tab" data-bs-toggle="tab" data-bs-target="#rejected" type="button" role="tab">
                        Rejected Requests
                        {{#if rejectedRequests.length}}
                            <span class="badge bg-danger ms-2">{{rejectedRequests.length}}</span>
                        {{/if}}
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="completed-tab" data-bs-toggle="tab" data-bs-target="#completed" type="button" role="tab">
                        Completed Requests
                        {{#if completedRequests.length}}
                            <span class="badge bg-success ms-2">{{completedRequests.length}}</span>
                        {{/if}}
                    </button>
                </li>
            </ul>

            <!-- Tab Content -->
            <div class="tab-content" id="requestTabsContent">
                <!-- Approved Requests Tab -->
                <div class="tab-pane fade show active" id="approved" role="tabpanel">
                    {{#if approvedRequests.length}}
                        <div class="table-responsive mt-3">
                            <table class="table table-striped table-hover">
                                <thead>
                                    <tr>
                                        <th>Request ID</th>
                                        <th>Homeowner</th>
                                        <th>Appliance</th>
                                        <th>Issue</th>
                                        <th>Date</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {{#each approvedRequests}}
                                        <tr>
                                            <td><strong>{{this.id}}</strong></td>
                                            <td>{{this.homeownerEmail}}</td>
                                            <td>{{this.appliance}}</td>
                                            <td>{{this.issue}}</td>
                                            <td>{{formatDate this.timestamp}}</td>
                                            <td>
                                                <form action="/complete" method="POST" style="display: inline;">
                    <input type="hidden" name="requestId" value="{{this.id}}">
                                                    <button type="submit" class="btn btn-success btn-sm">
                                                        <i class="bi bi-check-circle me-1"></i>Mark Complete
                                                    </button>
                </form>
                                            </td>
                                        </tr>
                                    {{/each}}
                                </tbody>
                            </table>
                        </div>
                    {{else}}
                        <div class="text-center text-muted py-5 mt-3">
                            <i class="bi bi-check-circle display-1"></i>
                            <h4 class="mt-3">No Approved Requests</h4>
                            <p>You have no approved requests at the moment.</p>
                        </div>
                    {{/if}}
                </div>

                <!-- Rejected Requests Tab -->
                <div class="tab-pane fade" id="rejected" role="tabpanel">
                    {{#if rejectedRequests.length}}
                        <div class="table-responsive mt-3">
                            <table class="table table-striped table-hover">
                                <thead>
                                    <tr>
                                        <th>Request ID</th>
                                        <th>Homeowner</th>
                                        <th>Appliance</th>
                                        <th>Issue</th>
                                        <th>Date</th>
                                        <th>Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {{#each rejectedRequests}}
                                        <tr>
                                            <td><strong>{{this.id}}</strong></td>
                                            <td>{{this.homeownerEmail}}</td>
                                            <td>{{this.appliance}}</td>
                                            <td>{{this.issue}}</td>
                                            <td>{{formatDate this.timestamp}}</td>
                                            <td><span class="badge bg-danger">Rejected</span></td>
                                        </tr>
                                    {{/each}}
                                </tbody>
                            </table>
                        </div>
                    {{else}}
                        <div class="text-center text-muted py-5 mt-3">
                            <i class="bi bi-x-circle display-1"></i>
                            <h4 class="mt-3">No Rejected Requests</h4>
                            <p>You have no rejected requests.</p>
                        </div>
                    {{/if}}
                </div>

                <!-- Completed Requests Tab -->
                <div class="tab-pane fade" id="completed" role="tabpanel">
                    {{#if completedRequests.length}}
                        <div class="table-responsive mt-3">
                            <table class="table table-striped table-hover">
                                <thead>
                                    <tr>
                                        <th>Request ID</th>
                                        <th>Homeowner</th>
                                        <th>Appliance</th>
                                        <th>Issue</th>
                                        <th>Completed Date</th>
                                        <th>Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {{#each completedRequests}}
                                        <tr>
                                            <td><strong>{{this.id}}</strong></td>
                                            <td>{{this.homeownerEmail}}</td>
                                            <td>{{this.appliance}}</td>
                                            <td>{{this.issue}}</td>
                                            <td>{{formatDate this.completedTimestamp}}</td>
                                            <td><span class="badge bg-success">Completed</span></td>
                                        </tr>
                                    {{/each}}
                                </tbody>
                            </table>
                        </div>
                    {{else}}
                        <div class="text-center text-muted py-5 mt-3">
                            <i class="bi bi-check-circle display-1"></i>
                            <h4 class="mt-3">No Completed Requests</h4>
                            <p>You have no completed requests yet.</p>
                        </div>
                    {{/if}}
                </div>
            </div>
            </div>
        </div>
</div>

<!-- Chart.js CDN -->
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>
// Monthly Completion Rate Chart
const monthlyCtx = document.getElementById('monthlyChart').getContext('2d');
const monthlyChart = new Chart(monthlyCtx, {
    type: 'line',
    data: {
        labels: [{{#each stats.monthlyData}}'{{this.month}}'{{#unless @last}},{{/unless}}{{/each}}],
        datasets: [{
            label: 'Completion Rate (%)',
            data: [{{#each stats.monthlyData}}{{this.rate}}{{#unless @last}},{{/unless}}{{/each}}],
            borderColor: 'rgb(75, 192, 192)',
            backgroundColor: 'rgba(75, 192, 192, 0.2)',
            tension: 0.1,
            fill: true
        }]
    },
    options: {
        responsive: true,
        maintainAspectRatio: false,
        scales: {
            y: {
                beginAtZero: true,
                max: 100,
                ticks: {
                    callback: function(value) {
                        return value + '%';
                    }
                }
            }
        },
        plugins: {
            legend: {
                display: false
            }
        }
    }
});

// Weekly Completion Rate Chart
const weeklyCtx = document.getElementById('weeklyChart').getContext('2d');
const weeklyChart = new Chart(weeklyCtx, {
    type: 'bar',
    data: {
        labels: [{{#each stats.weeklyData}}'{{this.week}}'{{#unless @last}},{{/unless}}{{/each}}],
        datasets: [{
            label: 'Completion Rate (%)',
            data: [{{#each stats.weeklyData}}{{this.rate}}{{#unless @last}},{{/unless}}{{/each}}],
            backgroundColor: [
                'rgba(255, 99, 132, 0.8)',
                'rgba(54, 162, 235, 0.8)',
                'rgba(255, 205, 86, 0.8)',
                'rgba(75, 192, 192, 0.8)'
            ],
            borderColor: [
                'rgba(255, 99, 132, 1)',
                'rgba(54, 162, 235, 1)',
                'rgba(255, 205, 86, 1)',
                'rgba(75, 192, 192, 1)'
            ],
            borderWidth: 1
        }]
    },
    options: {
        responsive: true,
        maintainAspectRatio: false,
        scales: {
            y: {
                beginAtZero: true,
                max: 100,
                ticks: {
                    callback: function(value) {
                        return value + '%';
                    }
                }
            }
        },
        plugins: {
            legend: {
                display: false
            }
        }
    }
});

// Status Distribution Chart
const statusCtx = document.getElementById('statusChart').getContext('2d');
const statusChart = new Chart(statusCtx, {
    type: 'doughnut',
    data: {
        labels: ['Completed', 'Pending', 'Accepted', 'Rejected'],
        datasets: [{
            data: [{{stats.completed}}, {{stats.pending}}, {{stats.accepted}}, {{stats.rejected}}],
            backgroundColor: [
                'rgba(40, 167, 69, 0.8)',
                'rgba(255, 193, 7, 0.8)',
                'rgba(0, 123, 255, 0.8)',
                'rgba(220, 53, 69, 0.8)'
            ],
            borderColor: [
                'rgba(40, 167, 69, 1)',
                'rgba(255, 193, 7, 1)',
                'rgba(0, 123, 255, 1)',
                'rgba(220, 53, 69, 1)'
            ],
            borderWidth: 2
        }]
    },
    options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
            legend: {
                position: 'bottom'
            }
        }
    }
});

// Request Volume Trends Chart
const volumeCtx = document.getElementById('volumeChart').getContext('2d');
const volumeChart = new Chart(volumeCtx, {
    type: 'bar',
    data: {
        labels: [{{#each stats.monthlyData}}'{{this.month}}'{{#unless @last}},{{/unless}}{{/each}}],
        datasets: [{
            label: 'Total Requests',
            data: [{{#each stats.monthlyData}}{{this.total}}{{#unless @last}},{{/unless}}{{/each}}],
            backgroundColor: 'rgba(54, 162, 235, 0.8)',
            borderColor: 'rgba(54, 162, 235, 1)',
            borderWidth: 1
        }]
    },
    options: {
        responsive: true,
        maintainAspectRatio: false,
        scales: {
            y: {
                beginAtZero: true,
                ticks: {
                    stepSize: 1
                }
            }
        },
        plugins: {
            legend: {
                display: false
            }
        }
    }
});

// Response Time Analytics Chart
const responseCtx = document.getElementById('responseChart').getContext('2d');
const responseChart = new Chart(responseCtx, {
    type: 'line',
    data: {
        labels: [{{#each stats.weeklyData}}'{{this.week}}'{{#unless @last}},{{/unless}}{{/each}}],
        datasets: [{
            label: 'Response Rate (%)',
            data: [{{#each stats.weeklyData}}{{this.rate}}{{#unless @last}},{{/unless}}{{/each}}],
            borderColor: 'rgb(255, 99, 132)',
            backgroundColor: 'rgba(255, 99, 132, 0.2)',
            tension: 0.1,
            fill: true
        }]
    },
    options: {
        responsive: true,
        maintainAspectRatio: false,
        scales: {
            y: {
                beginAtZero: true,
                max: 100,
                ticks: {
                    callback: function(value) {
                        return value + '%';
                    }
                }
            }
        },
        plugins: {
            legend: {
                display: false
            }
        }
    }
});
</script>

<style>
.card {
    box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075);
    border: 1px solid rgba(0, 0, 0, 0.125);
}

.card-header {
    background-color: #f8f9fa;
    border-bottom: 1px solid rgba(0, 0, 0, 0.125);
}

canvas {
    max-height: 300px;
}
</style>