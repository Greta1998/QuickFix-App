<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>QuickFix</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
  <link rel ="stylesheet" href="/landingpage.css">
</head>
<body class="d-flex flex-column min-vh-100">
  <!-- NAVBAR -->
  <nav class="navbar navbar-expand-lg navbar-light bg-white shadow-sm">
    <div class="container">
      <a class="navbar-brand" href="#">
        <i class="bi bi-wrench-adjustable text-primary"></i>
        <strong class = "text-primary">QuickFix</strong>
      </a>
      <ul class="navbar-nav ms-auto">
        <li class="nav-item"><a class="nav-link" href="login">Log In</a></li>
        <li class="nav-item">
          <a class="btn btn-primary ms-2" href="signup">Get Started</a>
        </li>
      </ul>
    </div>
  </nav>

  <!-- HERO SECTION -->
  <section class="hero bg-primary text-center py-5">
    <div class="container">
      <h1 class="display-5">
        Find Trusted Technicians Near You
      </h1>
      <p class="lead mb-4">
        Connect with verified professionals for all your home repair needs.
        From plumbing to electrical work, find the right expert with built-in
        messaging, secure payments, and verified reviews.
      </p>
      <a href="login" class="btn btn-primary btn-lg me-2">
        Find a Technician <i class="bi bi-arrow-right-circle"></i>
      </a>
      <a href="signup" class="btn btn-secondary btn-lg">
        Join as a Professional
      </a>

      <div class="mt-4">
        <i class="bi bi-check2-circle text-success me-1"></i> Verified Professionals
        <i class="bi bi-check2-circle text-success ms-4 me-1"></i> Secure Payments
        <i class="bi bi-check2-circle text-success ms-4 me-1"></i> Real Reviews
      </div>
    </div>
  </section>

  <!-- HOW IT WORKS -->
  <section class="py-5">
    <div class="container text-center">
      <h2>How It Works</h2>
      <p class="text-muted mb-5">
        Getting help with your home projects has never been easier.
      </p>
      <div class="row g-4">
        {{!-- Step cards --}}
        <div class="col-md-3">
          <div class="card h-100 border-0 shadow-sm">
            <div class="card-body text-center">
              <i class="bi bi-search fs-1 text-primary mb-3"></i>
              <h5>1. Describe Your Need</h5>
              <p class="text-muted">
                Tell us what kind of help you need and your location.
              </p>
            </div>
          </div>
        </div>
        <div class="col-md-3">
          <div class="card h-100 border-0 shadow-sm">
            <div class="card-body text-center">
              <i class="bi bi-people fs-1 text-primary mb-3"></i>
              <h5>2. Get Matched</h5>
              <p class="text-muted">
                We’ll show you qualified technicians in your area.
              </p>
            </div>
          </div>
        </div>
        <div class="col-md-3">
          <div class="card h-100 border-0 shadow-sm">
            <div class="card-body text-center">
              <i class="bi bi-chat-dots fs-1 text-primary mb-3"></i>
              <h5>3. Connect & Discuss</h5>
              <p class="text-muted">
                Message technicians directly to discuss details.
              </p>
            </div>
          </div>
        </div>
        <div class="col-md-3">
          <div class="card h-100 border-0 shadow-sm">
            <div class="card-body text-center">
              <i class="bi bi-check2-all fs-1 text-primary mb-3"></i>
              <h5>4. Complete & Review</h5>
              <p class="text-muted">
                Pay securely and leave a review for others.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- FOOTER -->
  <footer class="mt-auto bg-dark text-white py-4">
  <div class="container text-center">
    <div class="row justify-content-center">
      <div class="col-md-4 text-center mb-3 mb-md-0">
        <h5><i class="bi bi-wrench-adjustable"></i> QuickFix</h5>
        <p>Connecting homeowners with trusted technicians.</p>
      </div>
      <div class="col-md-4 text-center mb-3 mb-md-0">
        <h6>Address</h6>
        <p>USIU road, Thika road<br/>Nairobi, Kenya</p>
      </div>
      <div class="col-md-4 text-center">
        <h6>Contact</h6>
        <p>Phone: +254717518532<br/>Email: support@quickfix.com</p>
      </div>
    </div>
    <div class="mt-3">© 2024 QuickFix. All rights reserved.</div>
  </div>
</footer>


  <!-- Bootstrap JS -->
    <script src="https://code.jquery.com/jquery-3.5.1.slim.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.9.2/dist/umd/popper.min.js"></script>
    <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>

</body>
</html>
