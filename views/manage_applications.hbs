<div class="container-fluid mt-4">
    <!-- Header -->
    <div class="row mb-4">
        <div class="col-12">
            <h2 class="text-center mb-3">Manage Technician Applications</h2>
            <p class="text-center text-muted">Review and approve/reject technician applications</p>
        </div>
    </div>

    <!-- Application Status Tabs -->
    <div class="row mb-4">
        <div class="col-12">
            <ul class="nav nav-tabs" id="applicationTabs" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active" id="pending-tab" data-bs-toggle="tab" data-bs-target="#pending" type="button" role="tab">
                        Pending Applications
                        {{#if pendingApplications.length}}
                            <span class="badge bg-warning ms-2">{{pendingApplications.length}}</span>
                        {{/if}}
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="approved-tab" data-bs-toggle="tab" data-bs-target="#approved" type="button" role="tab">
                        Approved Applications
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="rejected-tab" data-bs-toggle="tab" data-bs-target="#rejected" type="button" role="tab">
                        Rejected Applications
                    </button>
                </li>
            </ul>
        </div>
    </div>

    <!-- Tab Content -->
    <div class="tab-content" id="applicationTabsContent">
        <!-- Pending Applications Tab -->
        <div class="tab-pane fade show active" id="pending" role="tabpanel">
            <div class="row">
                {{#if pendingApplications.length}}
                    {{#each pendingApplications}}
                        <div class="col-md-6 col-lg-4 mb-4">
                            <div class="card h-100">
                                <div class="card-header d-flex justify-content-between align-items-center">
                                    <h6 class="mb-0">{{this.name}}</h6>
                                    <span class="badge bg-warning">Pending</span>
                                </div>
                                <div class="card-body">
                                    <div class="mb-3">
                                        <strong>Email:</strong> {{this.email}}
                                    </div>
                                    <div class="mb-3">
                                        <strong>Specialty:</strong> {{this.specialty}}
                                    </div>
                                    <div class="mb-3">
                                        <strong>Experience:</strong> {{this.experience}}
                                    </div>
                                    {{#if this.phone}}
                                        <div class="mb-3">
                                            <strong>Phone:</strong> {{this.phone}}
                                        </div>
                                    {{/if}}
                                    {{#if this.location}}
                                        <div class="mb-3">
                                            <strong>Location:</strong> {{this.location}}
                                        </div>
                                    {{/if}}
                                    {{#if this.bio}}
                                        <div class="mb-3">
                                            <strong>Bio:</strong>
                                            <p class="text-muted small">{{this.bio}}</p>
                                        </div>
                                    {{/if}}
                                    <div class="mb-3">
                                        <strong>Applied:</strong> 
                                        {{#if this.timestamp}}
                                            {{formatDate this.timestamp}}
                                        {{else}}
                                            Unknown
                                        {{/if}}
                                    </div>
                                </div>
                                <div class="card-footer">
                                    <div class="d-flex gap-2">
                                        <form action="/admin/applications/{{this.id}}/approve" method="POST" class="flex-fill">
                                            <button type="submit" class="btn btn-success w-100">
                                                <i class="bi bi-check-circle me-1"></i>Approve
                                            </button>
                                        </form>
                                        <form action="/admin/applications/{{this.id}}/reject" method="POST" class="flex-fill">
                                            <button type="submit" class="btn btn-danger w-100">
                                                <i class="bi bi-x-circle me-1"></i>Reject
                                            </button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </div>
                    {{/each}}
                {{else}}
                    <div class="col-12">
                        <div class="text-center text-muted py-5">
                            <i class="bi bi-inbox display-1"></i>
                            <h4 class="mt-3">No Pending Applications</h4>
                            <p>There are no pending technician applications at the moment.</p>
                        </div>
                    </div>
                {{/if}}
            </div>
        </div>

        <!-- Approved Applications Tab -->
        <div class="tab-pane fade" id="approved" role="tabpanel">
            {{#if approvedApplications.length}}
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>Email</th>
                                <th>Specialty</th>
                                <th>Experience</th>
                                <th>Phone</th>
                                <th>Location</th>
                                <th>Applied Date</th>
                                <th>Approved Date</th>
                            </tr>
                        </thead>
                        <tbody>
                            {{#each approvedApplications}}
                                <tr>
                                    <td>
                                        <strong>{{this.name}}</strong>
                                        <span class="badge bg-success ms-2">Approved</span>
                                    </td>
                                    <td>{{this.email}}</td>
                                    <td>{{this.specialty}}</td>
                                    <td>{{this.experience}}</td>
                                    <td>{{#if this.phone}}{{this.phone}}{{else}}-{{/if}}</td>
                                    <td>{{#if this.location}}{{this.location}}{{else}}-{{/if}}</td>
                                    <td>
                                        {{#if this.timestamp}}
                                            {{formatDate this.timestamp}}
                                        {{else}}
                                            Unknown
                                        {{/if}}
                                    </td>
                                    <td>
                                        {{#if this.decisionTimestamp}}
                                            {{formatDate this.decisionTimestamp}}
                                        {{else}}
                                            -
                                        {{/if}}
                                    </td>
                                </tr>
                            {{/each}}
                        </tbody>
                    </table>
                </div>
            {{else}}
                <div class="text-center text-muted py-5">
                    <i class="bi bi-check-circle display-1"></i>
                    <h4 class="mt-3">No Approved Applications</h4>
                    <p>No applications have been approved yet.</p>
                </div>
            {{/if}}
        </div>

        <!-- Rejected Applications Tab -->
        <div class="tab-pane fade" id="rejected" role="tabpanel">
            {{#if rejectedApplications.length}}
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>Email</th>
                                <th>Specialty</th>
                                <th>Experience</th>
                                <th>Phone</th>
                                <th>Location</th>
                                <th>Applied Date</th>
                                <th>Rejected Date</th>
                            </tr>
                        </thead>
                        <tbody>
                            {{#each rejectedApplications}}
                                <tr>
                                    <td>
                                        <strong>{{this.name}}</strong>
                                        <span class="badge bg-danger ms-2">Rejected</span>
                                    </td>
                                    <td>{{this.email}}</td>
                                    <td>{{this.specialty}}</td>
                                    <td>{{this.experience}}</td>
                                    <td>{{#if this.phone}}{{this.phone}}{{else}}-{{/if}}</td>
                                    <td>{{#if this.location}}{{this.location}}{{else}}-{{/if}}</td>
                                    <td>
                                        {{#if this.timestamp}}
                                            {{formatDate this.timestamp}}
                                        {{else}}
                                            Unknown
                                        {{/if}}
                                    </td>
                                    <td>
                                        {{#if this.decisionTimestamp}}
                                            {{formatDate this.decisionTimestamp}}
                                        {{else}}
                                            -
                                        {{/if}}
                                    </td>
                                </tr>
                            {{/each}}
                        </tbody>
                    </table>
                </div>
            {{else}}
                <div class="text-center text-muted py-5">
                    <i class="bi bi-x-circle display-1"></i>
                    <h4 class="mt-3">No Rejected Applications</h4>
                    <p>No applications have been rejected yet.</p>
                </div>
            {{/if}}
        </div>
    </div>

</div>


<style>
.card {
    box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075);
    border: 1px solid rgba(0, 0, 0, 0.125);
    transition: transform 0.2s ease-in-out;
}

.card:hover {
    transform: translateY(-2px);
    box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15);
}

.nav-tabs .nav-link {
    border: 1px solid transparent;
    border-top-left-radius: 0.375rem;
    border-top-right-radius: 0.375rem;
}

.nav-tabs .nav-link.active {
    color: #495057;
    background-color: #fff;
    border-color: #dee2e6 #dee2e6 #fff;
}

.badge {
    font-size: 0.75em;
}

.display-1 {
    font-size: 4rem;
    opacity: 0.3;
}

.table-responsive {
    border-radius: 0.375rem;
    box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075);
}

.table thead th {
    border-bottom: 2px solid #dee2e6;
    font-weight: 600;
    text-transform: uppercase;
    font-size: 0.875rem;
    letter-spacing: 0.5px;
}

.table tbody tr:hover {
    background-color: rgba(0, 123, 255, 0.05);
}

.table td {
    vertical-align: middle;
    padding: 0.75rem;
}

.badge {
    font-size: 0.7em;
}
</style>
