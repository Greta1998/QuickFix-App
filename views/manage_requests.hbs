<div class="container-fluid mt-4">
    <!-- Header -->
    <div class="row mb-4">
        <div class="col-12">
            <h2 class="text-center mb-3">Manage Requests</h2>
            <p class="text-center text-muted">Review and respond to repair requests</p>
        </div>
    </div>

    <!-- Request Status Tabs -->
    <div class="row mb-4">
        <div class="col-12">
            <ul class="nav nav-tabs" id="requestTabs" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active" id="pending-tab" data-bs-toggle="tab" data-bs-target="#pending" type="button" role="tab">
                        Pending Requests
                        {{#if requests.length}}
                            <span class="badge bg-warning ms-2">{{requests.length}}</span>
                        {{/if}}
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="accepted-tab" data-bs-toggle="tab" data-bs-target="#accepted" type="button" role="tab">
                        Approved Requests
                        {{#if approvedRequests.length}}
                            <span class="badge bg-primary ms-2">{{approvedRequests.length}}</span>
                        {{/if}}
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="rejected-tab" data-bs-toggle="tab" data-bs-target="#rejected" type="button" role="tab">
                        Rejected Requests
                        {{#if rejectedRequests.length}}
                            <span class="badge bg-danger ms-2">{{rejectedRequests.length}}</span>
                        {{/if}}
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="completed-tab" data-bs-toggle="tab" data-bs-target="#completed" type="button" role="tab">
                        Completed Requests
                        {{#if completedRequests.length}}
                            <span class="badge bg-success ms-2">{{completedRequests.length}}</span>
                        {{/if}}
                    </button>
                </li>
            </ul>
        </div>
    </div>

    <!-- Tab Content -->
    <div class="tab-content" id="requestTabsContent">
        <!-- Pending Requests Tab -->
        <div class="tab-pane fade show active" id="pending" role="tabpanel">
            <div class="row">
                {{#if requests.length}}
                    {{#each requests}}
                        <div class="col-md-6 col-lg-4 mb-4">
                            <div class="card h-100">
                                <div class="card-header d-flex justify-content-between align-items-center">
                                    <h6 class="mb-0">Request #{{this.id}}</h6>
                                    <span class="badge bg-warning">Pending</span>
                                </div>
                                <div class="card-body">
                                    <h6 class="card-title">{{this.appliance}}</h6>
                                    <p class="card-text text-muted small">{{this.description}}</p>
                                    <div class="mb-2">
                                        <strong>Client:</strong> {{this.homeownerEmail}}
                                    </div>
                                    {{#if this.urgency}}
                                        <div class="mb-2">
                                            <strong>Urgency:</strong> 
                                            <span class="badge 
                                                {{#if (eq this.urgency 'emergency')}}bg-danger{{/if}}
                                                {{#if (eq this.urgency 'high')}}bg-warning{{/if}}
                                                {{#if (eq this.urgency 'medium')}}bg-info{{/if}}
                                                {{#if (eq this.urgency 'low')}}bg-secondary{{/if}}
                                            ">
                                                {{this.urgency}}
                                            </span>
                                        </div>
                                    {{/if}}
                                    {{#if this.preferredTime}}
                                        <div class="mb-2">
                                            <strong>Preferred Time:</strong> {{this.preferredTime}}
                                        </div>
                                    {{/if}}
                                    <div class="mb-3">
                                        <strong>Submitted:</strong> 
                                        {{#if this.timestamp}}
                                            {{formatDate this.timestamp}}
                                        {{else}}
                                            Unknown
                                        {{/if}}
                                    </div>
                                </div>
                                <div class="card-footer">
                                    <form action="/respond" method="POST" class="d-flex gap-2">
                                        <input type="hidden" name="requestId" value="{{this.id}}">
                                        <button type="submit" name="status" value="Accepted" class="btn btn-success btn-sm flex-fill">
                                            <i class="bi bi-check-circle me-1"></i>Accept
                                        </button>
                                        <button type="submit" name="status" value="Rejected" class="btn btn-danger btn-sm flex-fill">
                                            <i class="bi bi-x-circle me-1"></i>Reject
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    {{/each}}
                {{else}}
                    <div class="col-12">
                        <div class="text-center text-muted py-5">
                            <i class="bi bi-inbox display-1"></i>
                            <h4 class="mt-3">No Pending Requests</h4>
                            <p>You don't have any pending requests at the moment.</p>
                        </div>
                    </div>
                {{/if}}
            </div>
        </div>

        <!-- Approved Requests Tab -->
        <div class="tab-pane fade" id="accepted" role="tabpanel">
            {{#if approvedRequests.length}}
                <div class="table-responsive mt-3">
                    <table class="table table-striped table-hover">
                        <thead>
                            <tr>
                                <th>Request ID</th>
                                <th>Homeowner</th>
                                <th>Appliance</th>
                                <th>Issue</th>
                                <th>Date</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            {{#each approvedRequests}}
                                <tr>
                                    <td><strong>{{this.id}}</strong></td>
                                    <td>{{this.homeownerEmail}}</td>
                                    <td>{{this.appliance}}</td>
                                    <td>{{this.description}}</td>
                                    <td>{{formatDate this.timestamp}}</td>
                                    <td>
                                        <form action="/complete" method="POST" style="display: inline;">
                                            <input type="hidden" name="requestId" value="{{this.id}}">
                                            <button type="submit" class="btn btn-success btn-sm">
                                                <i class="bi bi-check-circle me-1"></i>Mark Complete
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            {{/each}}
                        </tbody>
                    </table>
                </div>
            {{else}}
                <div class="text-center text-muted py-5 mt-3">
                    <i class="bi bi-check-circle display-1"></i>
                    <h4 class="mt-3">No Approved Requests</h4>
                    <p>You have no approved requests at the moment.</p>
                </div>
            {{/if}}
        </div>

        <!-- Rejected Requests Tab -->
        <div class="tab-pane fade" id="rejected" role="tabpanel">
            {{#if rejectedRequests.length}}
                <div class="table-responsive mt-3">
                    <table class="table table-striped table-hover">
                        <thead>
                            <tr>
                                <th>Request ID</th>
                                <th>Homeowner</th>
                                <th>Appliance</th>
                                <th>Issue</th>
                                <th>Date</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            {{#each rejectedRequests}}
                                <tr>
                                    <td><strong>{{this.id}}</strong></td>
                                    <td>{{this.homeownerEmail}}</td>
                                    <td>{{this.appliance}}</td>
                                    <td>{{this.description}}</td>
                                    <td>{{formatDate this.timestamp}}</td>
                                    <td><span class="badge bg-danger">Rejected</span></td>
                                </tr>
                            {{/each}}
                        </tbody>
                    </table>
                </div>
            {{else}}
                <div class="text-center text-muted py-5 mt-3">
                    <i class="bi bi-x-circle display-1"></i>
                    <h4 class="mt-3">No Rejected Requests</h4>
                    <p>You have no rejected requests.</p>
                </div>
            {{/if}}
        </div>

        <!-- Completed Requests Tab -->
        <div class="tab-pane fade" id="completed" role="tabpanel">
            {{#if completedRequests.length}}
                <div class="table-responsive mt-3">
                    <table class="table table-striped table-hover">
                        <thead>
                            <tr>
                                <th>Request ID</th>
                                <th>Homeowner</th>
                                <th>Appliance</th>
                                <th>Issue</th>
                                <th>Completed Date</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            {{#each completedRequests}}
                                <tr>
                                    <td><strong>{{this.id}}</strong></td>
                                    <td>{{this.homeownerEmail}}</td>
                                    <td>{{this.appliance}}</td>
                                    <td>{{this.description}}</td>
                                    <td>{{formatDate this.completedTimestamp}}</td>
                                    <td><span class="badge bg-success">Completed</span></td>
                                </tr>
                            {{/each}}
                        </tbody>
                    </table>
                </div>
            {{else}}
                <div class="text-center text-muted py-5 mt-3">
                    <i class="bi bi-check-circle display-1"></i>
                    <h4 class="mt-3">No Completed Requests</h4>
                    <p>You have no completed requests yet.</p>
                </div>
            {{/if}}
        </div>
    </div>

</div>

<style>
.card {
    box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075);
    border: 1px solid rgba(0, 0, 0, 0.125);
    transition: transform 0.2s ease-in-out;
}

.card:hover {
    transform: translateY(-2px);
    box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15);
}

.nav-tabs .nav-link {
    border: 1px solid transparent;
    border-top-left-radius: 0.375rem;
    border-top-right-radius: 0.375rem;
}

.nav-tabs .nav-link.active {
    color: #495057;
    background-color: #fff;
    border-color: #dee2e6 #dee2e6 #fff;
}

.badge {
    font-size: 0.75em;
}

.btn-sm {
    padding: 0.25rem 0.5rem;
    font-size: 0.875rem;
}

.display-1 {
    font-size: 4rem;
    opacity: 0.3;
}
</style>
