<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sign Up</title>
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css">
    <link rel="stylesheet" href="/styles.css"> 
</head>
<body>
    <div class="container mt-5" style="max-width: 400px;">
        <h2 class="text-center mb-4">SIGN UP</h2>
        
        <div class="alert alert-info" id="technicianInfo" style="display: none;">
            <small><strong>Technician Application:</strong> Additional information required for verification.</small>
        </div>

        <form action="/signup" method="POST" id="signupForm" class="bg-light p-4 rounded shadow">
            <div class="form-group">
                <label for="name">Full Name</label>
                <input type="text" name="name" class="form-control" id="name" required>
            </div>
            <div class="form-group">
                <label for="email">Email</label>
                <input type="email" name="email" class="form-control" id="email" required>
            </div>
            <div class="form-group">
                <label for="phone">Phone Number</label>
                <div class="input-group">
                    <input type="tel" class="form-control" id="phone" name="phone" 
                           placeholder="07XXXXXXXX" maxlength="10" pattern="[0-9]{10}"required>
                    <div class="input-group-append">
                        <button type="button" class="btn btn-outline-primary" id="sendOTP">
                            <i class="bi bi-send"></i> Send OTP
                        </button>
                    </div>
                </div>
                <small class="form-text text-muted">We'll send a verification code to this number</small>
            </div>
            <div class="form-group" id="otpSection" style="display: none;">
                <label for="otp">Verification Code</label>
                <div class="input-group">
                    <input type="text" class="form-control" id="otp" name="otp" 
                           placeholder="Enter 6-digit code" maxlength="6">
                    <div class="input-group-append">
                        <button type="button" class="btn btn-outline-success" id="verifyOTP">
                            <i class="bi bi-check-circle"></i> Verify
                        </button>
                    </div>
                </div>
                <small class="form-text">
                    <span id="otpStatus">Enter the code sent to your phone</span>
                    <span id="otpTimer" class="text-muted ms-2"></span>
                </small>
            </div>
            <div class="form-group">
                <label for="password">Password</label>
                <input type="password" name="password" class="form-control" id="password" required>
            </div>
            <div class="form-group">
                <label for="role">Role</label>
                <select name="role" class="form-control" id="role" required>
                    <option value="">Select your role...</option>
                    <option value="homeowner">Homeowner</option>
                    <option value="technician">Technician</option>
                </select>
            </div>

            <!-- Technician-specific fields (hidden by default) -->
            <div id="technicianFields" style="display: none;">
                <div class="form-group">
                    <label for="location">Location</label>
                    <input type="text" class="form-control" id="location" name="location" placeholder="e.g., Nairobi, Westlands">
                </div>
                <div class="form-group">
                    <label for="specialty">Specialization</label>
                    <select class="form-control" id="specialty" name="specialty">
                        <option value="">Select specialization...</option>
                        <option value="appliance_repair">General Appliance Repair</option>
                        <option value="refrigeration">Refrigeration & AC</option>
                        <option value="electrical">Electrical Appliances</option>
                        <option value="plumbing">Plumbing Appliances</option>
                        <option value="kitchen_appliances">Kitchen Appliances</option>
                        <option value="laundry_appliances">Laundry Appliances</option>
                        <option value="electronics">Electronics & Gadgets</option>
                        <option value="other">Other</option>
                    </select>
                </div>
                <div class="form-group">
                    <label for="experience">Experience</label>
                    <select class="form-control" id="experience" name="experience">
                        <option value="">Select experience...</option>
                        <option value="0-1">0-1 years</option>
                        <option value="2-3">2-3 years</option>
                        <option value="4-6">4-6 years</option>
                        <option value="7-10">7-10 years</option>
                        <option value="10+">10+ years</option>
                    </select>
                </div>
                <div class="form-group">
                    <label for="bio">Professional Bio</label>
                    <textarea class="form-control" id="bio" name="bio" rows="3" placeholder="Tell us about your experience and skills..."></textarea>
                </div>
                <div class="form-group">
                    <label for="idNumber">ID Number</label>
                    <input type="text" class="form-control" id="idNumber" name="idNumber" placeholder="Enter your ID number">
                </div>
                <div class="form-group">
                    <label for="serviceRadius">Service Radius (km)</label>
                    <select class="form-control" id="serviceRadius" name="serviceRadius">
                        <option value="">Select radius...</option>
                        <option value="5">5 km</option>
                        <option value="10">10 km</option>
                        <option value="15">15 km</option>
                        <option value="20">20 km</option>
                        <option value="25">25 km</option>
                        <option value="30+">30+ km</option>
                    </select>
                </div>
                <div class="form-check mb-3">
                    <input class="form-check-input" type="checkbox" id="terms" name="terms">
                    <label class="form-check-label" for="terms">
                        <small>I agree to the Terms and Conditions</small>
                    </label>
                </div>
            </div>

            <button type="submit" class="btn btn-primary btn-block" id="submitBtn">SIGN UP</button>
        </form>
        <p class="text-center mt-3">Already have an account? <a href="/login">Log in here</a></p>
    </div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const roleSelect = document.getElementById('role');
    const technicianFields = document.getElementById('technicianFields');
    const technicianInfo = document.getElementById('technicianInfo');
    const submitBtn = document.getElementById('submitBtn');
    const form = document.getElementById('signupForm');
    let otpTimer = null;
    let otpVerified = false;

    // OTP functionality
    document.getElementById('sendOTP').addEventListener('click', async function() {
        const phoneInput = document.getElementById('phone');
        const phone = phoneInput.value.trim();
        
        if (!phone) {
            alert('Please enter your phone number first');
            return;
        }

        const button = this;
        const originalText = button.innerHTML;
        
        button.disabled = true;
        button.innerHTML = '<i class="bi bi-hourglass-split"></i> Sending...';

        try {
            const response = await fetch('/api/send-otp', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ phone: phone })
            });

            const result = await response.json();
            
            if (result.success) {
                document.getElementById('otpSection').style.display = 'block';
                document.getElementById('otpStatus').textContent = 'Code sent! Check your phone.';
                startOTPTimer();
            } else {
                alert('Failed to send OTP: ' + result.message);
            }
        } catch (error) {
            console.error('OTP send error:', error);
            alert('Failed to send OTP. Please try again.');
        } finally {
            button.disabled = false;
            button.innerHTML = originalText;
        }
    });

    document.getElementById('verifyOTP').addEventListener('click', async function() {
        const phone = document.getElementById('phone').value.trim();
        const otp = document.getElementById('otp').value.trim();
        
        if (!phone || !otp) {
            alert('Please enter both phone number and OTP');
            return;
        }

        const button = this;
        const originalText = button.innerHTML;
        
        button.disabled = true;
        button.innerHTML = '<i class="bi bi-hourglass-split"></i> Verifying...';

        try {
            const response = await fetch('/api/verify-otp', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ phone: phone, otp: otp })
            });

            const result = await response.json();
            
            if (result.success) {
                otpVerified = true;
                document.getElementById('otpStatus').textContent = '✅ Phone verified successfully!';
                document.getElementById('otpStatus').className = 'text-success';
                button.innerHTML = '<i class="bi bi-check-circle"></i> Verified';
                button.className = 'btn btn-success';
                clearInterval(otpTimer);
            } else {
                alert('OTP verification failed: ' + result.message);
            }
        } catch (error) {
            console.error('OTP verify error:', error);
            alert('Failed to verify OTP. Please try again.');
        } finally {
            button.disabled = false;
            if (!otpVerified) {
                button.innerHTML = originalText;
            }
        }
    });

    function startOTPTimer() {
        let timeLeft = 300; // 5 minutes
        otpTimer = setInterval(() => {
            const minutes = Math.floor(timeLeft / 60);
            const seconds = timeLeft % 60;
            document.getElementById('otpTimer').textContent = `(${minutes}:${seconds.toString().padStart(2, '0')} remaining)`;
            
            if (timeLeft <= 0) {
                clearInterval(otpTimer);
                document.getElementById('otpTimer').textContent = '(Expired)';
                document.getElementById('otpStatus').textContent = 'OTP expired. Please request a new one.';
            }
            timeLeft--;
        }, 1000);
    }

    // Show/hide technician fields based on role selection
    roleSelect.addEventListener('change', function() {
        if (this.value === 'technician') {
            technicianFields.style.display = 'block';
            technicianInfo.style.display = 'block';
            submitBtn.innerHTML = 'SUBMIT APPLICATION';
        } else {
            technicianFields.style.display = 'none';
            technicianInfo.style.display = 'none';
            submitBtn.innerHTML = 'SIGN UP';
        }
    });

    // Form submission handling
    form.addEventListener('submit', async function(e) {
        e.preventDefault();

        // Check if OTP is verified
        if (!otpVerified) {
            alert('Please verify your phone number with OTP before submitting');
            return;
        }

        const submitBtn = form.querySelector('button[type="submit"]');
        const originalText = submitBtn ? submitBtn.textContent : '';
        if (submitBtn) {
            submitBtn.disabled = true;
            submitBtn.innerHTML = 'PROCESSING...';
        }

        try {
            const formData = new URLSearchParams();
            for (const pair of new FormData(form)) {
                formData.append(pair[0], pair[1]);
            }

            const res = await fetch(form.action, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                },
                body: formData
            });

            const result = await res.json();
            
            if (result.success) {
                if (roleSelect.value === 'technician') {
                    alert('Application submitted successfully! You will be notified once reviewed.');
                } else {
                    alert('Account created successfully! You can now log in.');
                }
                form.reset();
                setTimeout(() => {
                    window.location.href = '/login';
                }, 1500);
            } else {
                alert(result.error || 'Failed to create account. Please try again.');
            }

        } catch (err) {
            console.error('Submit failed:', err);
            alert('Failed to create account. Please try again.');
        } finally {
            if (submitBtn) {
                submitBtn.disabled = false;
                submitBtn.innerHTML = originalText;
            }
        }
    });
});
</script>
</body>
</html>