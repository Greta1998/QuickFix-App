<div class="container-fluid mt-4">
    <!-- Header -->
    <div class="row mb-4">
        <div class="col-12">
            <h2 class="text-center mb-3">Request Repair Service</h2>
            <p class="text-center text-muted">Submit a new repair request for your appliances</p>
        </div>
    </div>

    <div class="row justify-content-center">
        <div class="col-12 col-lg-8">
            <div class="card shadow-sm">
                <div class="card-body">
                    <form action="/request" method="POST" id="requestForm">
                        <div class="mb-3">
                            <label for="appliance" class="form-label">Type of Appliance</label>
                            <select name="appliance" class="form-control" id="appliance" required>
                                <option value="">Select an appliance...</option>
                                <option value="fridge">Fridge</option>
                                <option value="washing_machine">Washing Machine</option>
                                <option value="blender">Blender</option>
                                <option value="cooker">Cooker</option>
                                <option value="oven">Oven</option>
                                <option value="ac">Air Conditioner</option>
                                <option value="microwave">Microwave</option>
                                <option value="dishwasher">Dishwasher</option>
                                <option value="dryer">Dryer</option>
                                <option value="other">Other</option>
                            </select>
                        </div>

                        <!-- Location Input -->
                        <div class="mb-3">
                            <label for="userLocation" class="form-label">Your Location</label>
                            <div class="input-group">
                                <input type="text" class="form-control" id="userLocation" name="userLocation" 
                                       placeholder="Enter your address or city" required>
                                <button type="button" class="btn btn-outline-secondary" id="getCurrentLocation">
                                    <i class="bi bi-geo-alt"></i> Use Current Location
                                </button>
                            </div>
                            <div class="form-text">This helps us find technicians near you</div>
                        </div>

                        <!-- Advanced Search Filters -->
                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label for="specialtyFilter" class="form-label">Specialty</label>
                                <select class="form-select" id="specialtyFilter">
                                    <option value="">All Specialties</option>
                                    {{#each searchFilters.specialties}}
                                        <option value="{{this}}">{{this}}</option>
                                    {{/each}}
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label for="distanceFilter" class="form-label">Max Distance</label>
                                <select class="form-select" id="distanceFilter">
                                    {{#each searchFilters.distanceRanges}}
                                        <option value="{{max}}" {{#if (eq max 50)}}selected{{/if}}>{{label}}</option>
                                    {{/each}}
                                </select>
                            </div>
                        </div>

                        <!-- Search and Filter Buttons -->
                        <div class="mb-3">
                            <button type="button" class="btn btn-outline-primary me-2" id="searchTechnicians">
                                <i class="bi bi-search"></i> Search Technicians
                            </button>
                            <button type="button" class="btn btn-outline-secondary" id="clearFilters">
                                <i class="bi bi-x-circle"></i> Clear Filters
                            </button>
                        </div>

                        <!-- Technician Selection -->
                        <div class="mb-3">
                            <label for="technician" class="form-label">Preferred Technician</label>
                            <div id="technicianResults">
                                <select name="technician" class="form-control" id="technician" required>
                                    <option value="">Select a technician...</option>
                                    {{#each technicians}}
                                        <option value="{{this.email}}" data-distance="{{this.distance}}" data-rating="{{this.rating}}">
                                            {{this.name}}
                                            {{#if this.rating}}
                                                - {{#repeat this.rating}}★{{/repeat}}{{#repeat (sub 5 this.rating)}}☆{{/repeat}} ({{this.rating}}/5)
                                            {{else}}
                                                - No ratings yet
                                            {{/if}}
                                        </option>
                                    {{/each}}
                                </select>
                            </div>
                            <div class="form-text">Technicians are sorted by distance (nearest first) and rating</div>
                        </div>

                        <div class="mb-3">
                            <label for="description" class="form-label">Detailed Description of the Issue</label>
                            <textarea
                                id="description"
                                name="description"
                                rows="5"
                                class="form-control"
                                placeholder="Please provide a detailed description of the problem with your appliance. Include any error messages, unusual sounds, or behaviors you've noticed..."
                                required
                            ></textarea>
                            <div class="form-text">The more details you provide, the better we can help you</div>
                        </div>

                        <div class="mb-3">
                            <label for="urgency" class="form-label">Urgency Level</label>
                            <select name="urgency" class="form-control" id="urgency">
                                <option value="low">Low - Can wait a few days</option>
                                <option value="medium" selected>Medium - Within 1-2 days</option>
                                <option value="high">High - Same day service needed</option>
                                <option value="emergency">Emergency - Immediate attention required</option>
                            </select>
                        </div>

                        <div class="mb-3">
                            <label for="contactPhone" class="form-label">Contact Phone Number</label>
                            <input type="tel" class="form-control" id="contactPhone" name="contactPhone" 
                                   placeholder="07XXXXXXXX" maxlength="10" pattern="[0-9]{10}"required>
                            <div class="form-text">For technician to contact you directly</div>
                        </div>

                        <div class="mb-3">
                            <label for="preferredTime" class="form-label">Preferred Service Time</label>
                            <select name="preferredTime" class="form-control" id="preferredTime">
                                <option value="morning">Morning (8 AM - 12 PM)</option>
                                <option value="afternoon" selected>Afternoon (12 PM - 5 PM)</option>
                                <option value="evening">Evening (5 PM - 8 PM)</option>
                                <option value="flexible">Flexible - Any time</option>
                            </select>
                        </div>

                        <div class="d-grid">
                            <button type="submit" class="btn btn-primary btn-lg">
                                <i class="bi bi-tools me-2"></i>Submit Repair Request
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

</div>

<script>
(function() {
    const form = document.getElementById('requestForm');
    if (!form) return;

    let userCoordinates = null;

    // Get current location
    document.getElementById('getCurrentLocation').addEventListener('click', async function() {
        const locationInput = document.getElementById('userLocation');
        const button = this;
        
        button.disabled = true;
        button.innerHTML = '<i class="bi bi-hourglass-split me-2"></i>Getting Location...';

        try {
            if (navigator.geolocation) {
                const position = await new Promise((resolve, reject) => {
                    navigator.geolocation.getCurrentPosition(resolve, reject, {
                        enableHighAccuracy: true,
                        timeout: 10000,
                        maximumAge: 60000
                    });
                });

                userCoordinates = {
                    lat: position.coords.latitude,
                    lng: position.coords.longitude
                };

                // Reverse geocode to get address
                const address = await reverseGeocode(userCoordinates.lat, userCoordinates.lng);
                locationInput.value = address;
                
                // Search for nearby technicians
                await searchTechnicians();
                
            } else {
                alert('Geolocation is not supported by this browser');
            }
        } catch (error) {
            console.error('Location error:', error);
            alert('Unable to get your location. Please enter it manually.');
        } finally {
            button.disabled = false;
            button.innerHTML = '<i class="bi bi-geo-alt"></i> Use Current Location';
        }
    });

    // Search technicians based on filters
    document.getElementById('searchTechnicians').addEventListener('click', async function() {
        const button = this;
        const originalText = button.innerHTML;
        
        // Show loading state
        button.disabled = true;
        button.innerHTML = '<i class="bi bi-hourglass-split me-2"></i>Searching...';
        
        try {
            await searchTechnicians();
        } finally {
            // Reset button
            button.disabled = false;
            button.innerHTML = originalText;
        }
    });

    // Clear filters
    document.getElementById('clearFilters').addEventListener('click', function() {
        document.getElementById('specialtyFilter').value = '';
        document.getElementById('distanceFilter').value = '50';
        document.getElementById('userLocation').value = '';
        userCoordinates = null;
        
        // Reset technician dropdown
        const technicianSelect = document.getElementById('technician');
        technicianSelect.innerHTML = '<option value="">Select a technician...</option>';
    });


    // Search technicians function
    async function searchTechnicians() {
        console.log('🔍 Starting technician search...');
        
        const specialty = document.getElementById('specialtyFilter').value;
        const maxDistance = document.getElementById('distanceFilter').value;
        const location = document.getElementById('userLocation').value;
        
        console.log('Search parameters:', { specialty, maxDistance, location, userCoordinates });

        // Get coordinates if location is provided
        let coordinates = userCoordinates;
        if (!coordinates && location) {
            try {
                const response = await fetch('/api/get-location', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ address: location })
                });
                const data = await response.json();
                if (data.success) {
                    coordinates = data.coordinates;
                }
            } catch (error) {
                console.error('Geocoding error:', error);
            }
        }

        try {
            const response = await fetch('/api/search-technicians', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    specialty,
                    userLat: coordinates?.lat,
                    userLng: coordinates?.lng,
                    maxDistance: parseInt(maxDistance),
                    minRating: 0,
                })
            });

            const data = await response.json();
            console.log('Search response:', data);
            
            if (data.success) {
                console.log(`Found ${data.technicians.length} technicians`);
                console.log('Technicians data:', data.technicians);
                updateTechnicianDropdown(data.technicians);
            } else {
                console.error('Search failed:', data.error);
                alert('Search failed: ' + (data.error || 'Unknown error'));
            }
        } catch (error) {
            console.error('Search error:', error);
            alert('Search error: ' + error.message);
        }
    }

    // Update technician dropdown with search results
    function updateTechnicianDropdown(technicians) {
        const select = document.getElementById('technician');
        select.innerHTML = '<option value="">Select a technician...</option>';
        
        technicians.forEach(tech => {
            const option = document.createElement('option');
            option.value = tech.email;
            
            // Round rating to nearest tenth
            const roundedRating = tech.rating ? Math.round(tech.rating * 10) / 10 : 0;
            
            if (roundedRating > 0) {
                const stars = '★'.repeat(Math.floor(roundedRating)) + '☆'.repeat(5 - Math.floor(roundedRating));
                option.textContent = `${tech.name} - ${stars} (${roundedRating}/5)`;
            } else {
                option.textContent = `${tech.name} - No ratings yet`;
            }
            
            select.appendChild(option);
        });
    }

    // Reverse geocode coordinates to address
    async function reverseGeocode(lat, lng) {
        try {
            // Use a more stable approach - determine location based on coordinates
            // This is a simplified version - in production, use Google Maps Geocoding API
            
            // Kenya coordinates bounds (approximate)
            if (lat >= -4.7 && lat <= 5.5 && lng >= 33.9 && lng <= 41.9) {
                // Determine region based on coordinates
                if (lat >= -1.5 && lat <= -0.5 && lng >= 36.5 && lng <= 37.5) {
                    return 'Nairobi, Kenya';
                } else if (lat >= -4.2 && lat <= -3.8 && lng >= 39.3 && lng <= 40.0) {
                    return 'Mombasa, Kenya';
                } else if (lat >= -0.2 && lat <= 0.2 && lng >= 34.5 && lng <= 35.0) {
                    return 'Kisumu, Kenya';
                } else if (lat >= -0.4 && lat <= -0.2 && lng >= 35.8 && lng <= 36.4) {
                    return 'Nakuru, Kenya';
                } else if (lat >= 0.3 && lat <= 0.7 && lng >= 35.1 && lng <= 35.4) {
                    return 'Eldoret, Kenya';
                } else {
                    // Default to nearest major city
                    return 'Nairobi, Kenya';
                }
            } else {
                // Outside Kenya - use coordinates
                return `${lat.toFixed(4)}, ${lng.toFixed(4)}`;
            }
        } catch (error) {
            console.error('Reverse geocoding error:', error);
            return 'Location detected';
        }
    }

    form.addEventListener('submit', async function(e) {
        e.preventDefault();

        const submitBtn = form.querySelector('button[type="submit"]');
        const originalText = submitBtn ? submitBtn.textContent : '';
        if (submitBtn) {
            submitBtn.disabled = true;
            submitBtn.innerHTML = '<i class="bi bi-hourglass-split me-2"></i>Submitting...';
        }

        try {
            const formData = new FormData(form);
            const body = new URLSearchParams(formData);

            // Add location coordinates if available
            if (userCoordinates) {
                body.append('userLat', userCoordinates.lat);
                body.append('userLng', userCoordinates.lng);
            }

            const res = await fetch(form.action, {
                method: 'POST',
                headers: {
                    'Accept': 'application/json',
                    'Content-Type': 'application/x-www-form-urlencoded;charset=UTF-8'
                },
                body
            });

            if (!res.ok) {
                throw new Error('Network response was not ok');
            }

            // Show success message
            alert('✅ Request submitted successfully! A technician will contact you soon.');
            form.reset();
            
            // Redirect to dashboard after a short delay
            setTimeout(() => {
                window.location.href = '/homeowner-dashboard';
            }, 2000);

        } catch (err) {
            console.error('Submit failed:', err);
            alert('❌ Failed to submit request. Please try again.');
        } finally {
            if (submitBtn) {
                submitBtn.disabled = false;
                submitBtn.innerHTML = originalText;
            }
        }
    });
})();
</script>

<style>
.card {
    box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075);
    border: 1px solid rgba(0, 0, 0, 0.125);
}

.form-control:focus {
    border-color: #007bff;
    box-shadow: 0 0 0 0.2rem rgba(0, 123, 255, 0.25);
}

.btn-primary {
    background-color: #007bff;
    border-color: #007bff;
}

.btn-primary:hover {
    background-color: #0056b3;
    border-color: #0056b3;
}
</style>
